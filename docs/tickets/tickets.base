filters:
  and:
    - file.folder.contains("tickets/")
    - file.ext == "md"
formulas:
  area: file.folder.split("/").reverse()[0]
  rank: if(severity == "should-fix", 1, if(severity == "minor", 2, if(severity == "investigate", 3, 4)))
properties:
  file.name:
    displayName: Ticket
  formula.area:
    displayName: Area
  category:
    displayName: Category
  severity:
    displayName: Severity
  size:
    displayName: Size
  triage:
    displayName: Triage
  origin:
    displayName: Origin
  filed:
    displayName: Filed
  from:
    displayName: From
  blocked_by:
    displayName: Blocked by
views:
  - type: table
    name: By area
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - category
      - severity
      - size
      - triage
      - filed
      - from
      - blocked_by
    sort:
      - property: filed
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      note.severity: 116
      note.size: 63
  - type: table
    name: By severity
    filters:
      and:
        - category != "idea"
    groupBy:
      property: triage
      direction: ASC
    order:
      - file.name
      - formula.area
      - severity
      - category
      - size
      - filed
      - blocked_by
    sort:
      - property: formula.rank
        direction: ASC
      - property: filed
        direction: DESC
    columnSize:
      note.severity: 116
      note.size: 63
  - type: table
    name: Ready for agent
    filters:
      and:
        - category != "idea"
        - triage == "ready-for-agent"
        - blocked_by.isEmpty()
    order:
      - file.name
      - formula.area
      - category
      - severity
      - size
      - filed
      - from
    sort:
      - property: formula.rank
        direction: ASC
      - property: filed
        direction: DESC
  - type: table
    name: Ideas
    filters:
      and:
        - category == "idea"
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - origin
      - filed
      - from
    sort:
      - property: filed
        direction: DESC
      - property: file.name
        direction: ASC
  - type: table
    name: By origin
    groupBy:
      property: from
      direction: ASC
    order:
      - file.name
      - formula.area
      - category
      - severity
      - origin
      - filed
    sort:
      - property: filed
        direction: DESC
      - property: file.name
        direction: ASC
